{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFT Strategist", "version": "0.1.0", "identifier": "local.tft-strategist.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "TFT Strategist", "width": 1440, "height": 940, "minWidth": 860, "minHeight": 640, "backgroundColor": "#0c1017" }], "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.communitydragon.org; img-src 'self' data: https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'; script-src 'self'" } },
  "bundle": { "active": false },
  "plugins": { "sql": { "preload": ["sqlite:strategist.db"] } }
}
