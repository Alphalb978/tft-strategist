{
  "name": "tft-strategist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs",
    "data:refresh": "tsx scripts/refresh-data.ts",
    "test:ui": "playwright test",
    "benchmark:m3": "tsx scripts/benchmark-scouting.ts",
    "benchmark:m4": "tsx scripts/benchmark-m4.ts",
    "benchmark:m5": "tsx scripts/benchmark-m5.ts",
    "m5:live-smoke": "tsx scripts/live-m5-smoke.ts",
    "format": "prettier --write src scripts e2e *.json *.ts *.js data/playbooks data/rules --ignore-unknown",
    "format:check": "prettier --check src scripts e2e *.json *.ts *.js data/playbooks data/rules --ignore-unknown"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
